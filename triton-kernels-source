 84 |     src = inspect.getsource(fn.fn)
 85 |     src = textwrap.dedent(src)
 86 |     lines = src.split("\n")
 87 |     # Skip decorator and def line
 88 |     def_idx = next(i for i, line in enumerate(lines) if line.strip().startswith("def"))
 89 |     # separate header vs body LOC
 90 |     header_end = def_idx
 91 |     while not lines[header_end].rstrip().endswith(":"):
 92 |         header_end += 1
 93 |     body_lines = lines[header_end + 1:]
 94 |     header_lines = lines[def_idx:header_end + 1]
 95 |     # clean-up header
 96 |     header_clean = [
 97 |         l.split("#", 1)[0].strip()  # keep code, discard comment
 98 |         for l in header_lines
 99 |         if l.split("#", 1)[0].strip()  # skip blank‑after‑comment lines
100 |     ]
101 |     # decompose arguments
102 |     header_src = " ".join(header_clean)  # turn it into a single line
103 |     m = re.search(r"\((.*)\)\s*:", header_src)
104 |     if not m:
105 |         raise ValueError("Could not parse function header")
106 |     args_str = m.group(1)
107 |     args = [arg.strip() for arg in args_str.split(",") if arg.strip()]
108 |     non_specialized_args = []
109 |     for arg in args:
110 |         arg_key = arg.split(":")[0].split("=")[0].strip()
111 |         new_args = tuples.get(arg_key, [arg])
112 |         if arg_key not in constants:
113 |             non_specialized_args += new_args
114 |     # add global symbols
115 |     spec_fns = {v.__name__: v for k, v in constants.items() if isinstance(v, triton.runtime.jit.JITFunction)}
116 |     globals = spec_fns | fn.get_capture_scope()
117 |     # build new source code and define kernel dynamically
118 |     new_signature = f"def {name}({', '.join(non_specialized_args)}):"
119 |     constexpr_lines = [
120 |         f"    {key}: tl.constexpr = {value.__name__ if callable(value) else value}" for key, value in constants.items()
121 |     ]
122 |     tuple_lines = [
123 |         f"    {key} = {'(' + ','.join(value) + (',' if len(value)>=1 else '') + ')'}" for key, value in tuples.items()
124 |     ]
125 |     new_src = "\n".join(["@triton.jit", new_signature] + constexpr_lines + tuple_lines + body_lines)
126 |     # Track how many logical lines precede the function body so we can adjust
127 |     # the bookkeeping metadata to match the template definition.
128 |     new_preamble_len = 1 + len(constexpr_lines) + len(tuple_lines)  # def + injected init lines
129 |     original_preamble_len = len(header_lines)
