231 | def _unpack_fp4_to_bf16_triton(x):
232 |     # Use fma on a100 as there is no mul.bf16x2.
233 |     use_mul: tl.constexpr = cuda_capability_geq(9)
234 |     op_instr: tl.constexpr = "mul.bf16x2" if use_mul else "fma.rn.bf16x2"
235 |     op_suffix: tl.constexpr = "" if use_mul else ", z"
236 |     r0, r1 = tl.inline_asm_elementwise(
237 |         asm=f"""{{
238 |             .reg .b32 b, c, z, d<7>, scale;
239 |             .reg .b32 bias;
240 |             mov.b32 z, 0;
241 |             mov.b32 bias, 0x7e807e80; // 2 ** 126 == 2 ** (bias_bf16 - bias_fp2)
242 |             // We add the missing bias to the scale directly
243 |             and.b32 $0, $4, 0b10000001110000001000000111000000;
244 |             {op_instr} $0, $0, bias{op_suffix};
245 |             shl.b32 b, $4, 3;
246 |             and.b32 $1, b,  0b10000001110000001000000111000000;
247 |             {op_instr} $1, $1, bias{op_suffix};
248 |             shl.b32 c, $4, 6;
249 |             and.b32 $2, c,  0b10000001110000001000000111000000;
250 |             {op_instr} $2, $2, bias{op_suffix};
251 |             // Unpack last two elements
252 |             shl.b32 d0, $4, 1;
253 |             and.b32 d1, d0, 0b10000000000000001000000000000000;
254 |             shr.b32 d2, $4, 3;
255 |             and.b32 d3, d2, 0b00000001100000000000000110000000;
256 |             or.b32 d4, d1, d3;
257 |             shr.b32 d5, $4, 7;
258 |             and.b32 d6, d5, 0b00000000010000000000000001000000;
259 |             or.b32 $3, d4, d6;
260 |             {op_instr} $3, $3, bias{op_suffix};
261 |         }}""",
262 |         constraints="=r,=r,=r,=r,r",
263 |         args=[x],
264 |         dtype=(tl.bfloat16, tl.bfloat16),
265 |         is_pure=True,
266 |         pack=4,
267 |     )
268 |     # Concat each pack of 4
269 |     x = tl.join(r0, r1)
270 |     x = x.reshape(x.shape[0], x.shape[1] // 4, 4, x.shape[2])
271 |     x = x.trans(0, 1, 3, 2)
272 |     x = x.reshape(x.shape[0], x.shape[1] * x.shape[2] * x.shape[3])
