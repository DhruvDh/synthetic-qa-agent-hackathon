179 |     def unswizzle_data(self, data):
180 |         data = self._maybe_mT(data)
181 |         data = _unpack_bits(data, self.mx_axis)
182 |         *batch, M, K = data.shape
183 |         # We have two times the elements if we already upcasted to bfloat16
184 |         mult = 2 if data.dtype == torch.bfloat16 else 1
185 |         assert M % 4 == 0, "M must be divisible by 4"
186 |         assert K % (4 * 8 * 2 * 2 * mult) == 0, f"K must be divisible by {4 * 8 * 2 * 2 * mult}"
187 |         # We are loading 8 bf16 elements per thread to use ld.global.v4
188 |         # Every u8 represents 2 mxfp4 elements
189 |         u8_kwidth = 8 // 2 if self.mma_version == 2 else 1
190 |         data = data.reshape(*batch, M // 4, 4, K // (4 * 8 * 2 * 2 * mult), 2, 4, 8 // u8_kwidth, 2, u8_kwidth * mult)
191 |         b = len(batch)
192 |         perm = [0, 6, 1, 3, 2, 5, 4, 7]
193 |         perm = list(range(b)) + [b + p for p in perm]
194 |         data = data.permute(*perm)
195 |         data = data.reshape(*batch, M * 4, K // 4)
