100 |     def swizzle_data(self, data):
101 |         """
102 |         Given a uint8 tensor of shape (*, M, K), returns a tensor of shape
103 |         (*, M // 4, K * 4) such that:
104 | 
105 |         1) Groups contiguously all the elements owned by the same thread of 4
106 |         mma tiles along the K axis. The following animation shows a similar
107 |         grouping for 2 tiles along M and 2 tiles along K rather than 4 along K
108 |         as done here:
109 |         https://neuralmagic.com/wp-content/uploads/2024/10/animation_4.gif
110 | 
111 |         2) Moves the elements belonging to thread 4-7 to be contiguous with those
112 |         from thread 0-3. This is done to get a full cache line when loading them
113 |         from HBM.
114 | 
115 |         mx_axis selects the lhs or rhs of the matmul.
116 | 
117 |         WARNING: Assumes that the matmul will be done in bf16 or fp16!
118 |         Implementing it for fp8 is as easy as making the tile size (8, 8)
119 |         """
120 |         batch = data.ndim - 2
121 |         assert batch >= 0
122 |         assert self.mma_version in (2, 3)
123 |         data = self._maybe_mT(data)
124 |         init_shape = data.shape
125 | 
126 |         # We are loading 8 bf16 elements per thread to use ld.global.v4
127 |         # Every u8 represents 2 mxfp4 elements
128 |         u8_kwidth = 8 // 2 if self.mma_version == 2 else 1
129 | 
130 |         # Pack the 4 // u8_kwidth subtiles of an mma into a u4x8
131 |         contig = (1, u8_kwidth)
132 |         scott_trick = (2, 1)
133 |         threads = (4, 4)
134 |         warp_tile = (2, 2)
135 |         k_tile = (1, 4 // u8_kwidth)
136 | 
137 |         sizes = list(data.shape[:-2])
138 |         pads = []
139 |         # [rest, K, tile, threads] per dimension
140 |         for i, (a, b, c, s, d) in enumerate(zip(k_tile, warp_tile, threads, scott_trick, contig)):
141 |             pack = a * b * c * s * d
142 |             size = data.shape[batch + i]
143 |             pad = (pack - size % pack) % pack
144 |             pads += [(0, pad)]
145 |             sizes.append((size + pad) // pack)
146 |             sizes += [a, b, c, s, d]
147 | 
148 |         pads = tuple(x for t in pads[::-1] for x in t)
149 |         data = torch.nn.functional.pad(data, pads)
150 |         init_shape = data.shape
151 |         # 0: rest[0]
152 |         # 1: k_tile[0]
153 |         # 2: warp_tile[0]
154 |         # 3: threads[0]
155 |         # 4: scott_trick[0]
156 |         # 5: contig[0]
157 |         # 6: rest[1]
158 |         # 7: k_tile[1]
159 |         # 8: warp_tile[1]
160 |         # 9: threads[1]
161 |         # 10: scott_trick[1]
162 |         # 11: contig[1]
163 |         data = data.view(*sizes)
164 |         # Want [rest[0], threads[0], rest[1], scott_trick[0], scott_trick[0], threads[1], contig[1], contig[0], k_tile[1], k_tile[0], warp_tile[1], warp_tile[0]]
165 |         perm = [0, 3, 6, 10, 4, 9, 7, 1, 8, 2, 5, 11]
166 |         perm = list(range(batch)) + [batch + p for p in perm]
167 |         data = data.permute(*perm).contiguous()
168 |         # These are views
169 |         data = data.flatten(-10, -1)
170 |         data = data.flatten(-3, -2)
171 |         assert data.is_contiguous()
172 |         assert data.shape[-2] == init_shape[-2] // 4
173 |         assert data.shape[-1] == init_shape[-1] * 4
174 |         # twiddle the bits
175 |         data = _pack_bits(data, self.mx_axis)
176 |         data = self._maybe_mT(data)
177 |         return data
