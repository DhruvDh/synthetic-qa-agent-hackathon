 88 |             out = tl.cumsum(partial_col_sum, 0) - partial_col_sum + curr_sum
 89 |             curr_sum += tl.sum(partial_col_sum, 0)
 90 |             tl.store(PartialColSum + offs, out, mask=offs < shape_pm)
