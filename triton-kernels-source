182 | def plot_roofline(series, flops_dtype, out_path, max_tbps="memset", max_tflops="cublas", title="", xlabel="",
183 |                   labels=None, points_of_interest=None):
184 |     from bisect import bisect_left
185 |     from pathlib import Path
186 | 
187 |     perfs = [load_perf_csv(p) for p in series]
188 |     validate_perfs(perfs)
189 |     xs, flops_ref, bytes_ref, _ = perfs[0]
190 |     n = len(xs)
191 | 
192 |     if not isinstance(max_tbps, int):
193 |         assert max_tbps == "memset"
194 |         max_tbps = get_memset_tbps()
195 |     if not isinstance(max_tflops, int):
196 |         assert max_tflops == "cublas"
197 |         max_tflops = get_cublas_tflops(flops_dtype)
198 | 
199 |     grey = "#7f7f7f"
200 |     opints = [f / b for f, b in zip(flops_ref, bytes_ref)]  # arithmetic intensity per sample
201 |     kappa = max_tflops / max_tbps  # intensity at the knee
202 | 
203 |     # --- knee interpolation ---
204 |     knee_idx = bisect_left(opints, kappa)
205 |     if knee_idx <= 0:
206 |         x_knee = xs[0]
207 |     elif knee_idx >= n:
208 |         x_knee = xs[-1]
209 |     else:
210 |         i0, i1 = knee_idx - 1, knee_idx
211 |         t = (kappa - opints[i0]) / (opints[i1] - opints[i0])
212 |         x_knee = xs[i0] + t * (xs[i1] - xs[i0])
213 | 
214 |     # --- piecewise roofline segments (for plotting the grey guideline) ---
215 |     if knee_idx >= n:
216 |         bw_x, bw_y = xs[:], [op * max_tbps for op in opints]
217 |         comp_x, comp_y = [], []
218 |     elif knee_idx <= 0:
219 |         bw_x, bw_y = [], []
220 |         comp_x, comp_y = xs[:], [max_tflops] * n
221 |     else:
222 |         bw_x = xs[:knee_idx] + [x_knee]
223 |         bw_y = [op * max_tbps for op in opints[:knee_idx]] + [max_tflops]
224 |         comp_x = [x_knee] + xs[knee_idx:]
225 |         comp_y = [max_tflops] * (1 + (n - knee_idx))
226 | 
227 |     y_roof = [min(op * max_tbps, max_tflops) for op in opints]
228 | 
229 |     # --- helpers ---
230 |     def interp(yxs, yys, x):
231 |         """Linear interpolation on (xs, ys), clamped at the ends."""
232 |         j = bisect_left(yxs, x)
233 |         if j <= 0:
234 |             return yys[0]
235 |         if j >= len(yxs):
236 |             return yys[-1]
237 |         x0, x1 = yxs[j - 1], yxs[j]
238 |         y0, y1 = yys[j - 1], yys[j]
239 |         t = (x - x0) / (x1 - x0) if x1 != x0 else 0.0
240 |         return y0 + t * (y1 - y0)
241 | 
242 |     # Prepare series curves
243 |     series_perf, series_labels = [], []
244 |     for idx, (pth, (_, f, b, t)) in enumerate(zip(series, perfs)):
245 |         perf = [ff / tt * 1e-3 if tt > 0 else 0.0 for ff, tt in zip(f, t)]
246 |         series_perf.append(perf)
247 |         series_labels.append(labels[idx] if labels and idx < len(labels) else Path(pth).stem)
248 | 
249 |     # --- draw ---
250 |     fig, ax = plt.subplots(figsize=(7, 5), dpi=120)
251 |     ax.set_xlabel(xlabel)
252 |     ax.set_ylabel("performance  [TFLOP/s]")
253 |     ax.set_title(title)
254 | 
255 |     # Grey roofline (guides)
256 |     if bw_x:
257 |         ax.plot(bw_x, bw_y, ls="--", color=grey, label=f"BW-bound - {max_tbps:.1f} TB/s [memset]")
258 |     if comp_x:
259 |         ax.plot(comp_x, comp_y, ls=":", color=grey, label=f"Compute-bound - {max_tflops:.0f} TFLOP/s [cuBLAS]")
260 | 
261 |     # Series
262 |     for lab, perf in zip(series_labels, series_perf):
263 |         ax.plot(xs, perf, label=lab, lw=1.8, zorder=2)
264 | 
265 |     # Layout (full extent)
266 |     xmin, xmax = xs[0], xs[-1]
267 |     dx = 0.05 * (xmax - xmin) if xmax > xmin else 1.0
268 |     ax.set_xlim(xmin - dx, xmax + dx)
269 |     ax.set_ylim(min(min(perf) for perf in series_perf) * 0.8 if series_perf else 0.0, max_tflops * 1.05)
270 | 
271 |     # Points of interest
272 |     if points_of_interest:
273 |         for x_pt, label in points_of_interest.items():
274 |             y_pt = interp(xs, series_perf[0], x_pt)
275 |             y_rf = interp(xs, y_roof, x_pt)
276 |             ax.plot([x_pt], [y_pt], marker="o", ms=4, mfc="white", mec="black", zorder=3)
277 |             ax.annotate(f"{label}\n{int(y_pt)} TFLOP/s ({int(y_pt/y_rf*100)}%)", xy=(x_pt, y_pt), xytext=(5, -25),
278 |                         textcoords="offset points", fontsize=7, ha="left", va="bottom")
279 | 
280 |     ax.legend(frameon=False, loc="lower right")
281 |     ax.grid(True, which="both", ls=":", lw=0.5)
282 | 
283 |     plt.savefig(out_path)
284 | 
285 | 
286 | if __name__ == "__main__":
287 |     import argparse
288 |     parser = argparse.ArgumentParser(description="Plot roofline(s) from perf CSV series")
289 |     parser.add_argument("--series", type=str, nargs="+", required=True,
290 |                         help="list of .csv files; columns must be `x`, `flops`, `bytes`, `time_ns`")
291 |     parser.add_argument("--dtype", type=str, required=True, choices=["fp16", "bf16", "fp8"],
292 |                         help="data type used for compute-bound roof")
293 |     parser.add_argument("--out_path", type=str, required=True, help="path to write the output image")
294 |     parser.add_argument("--title", type=str, default="", help="plot title")
295 |     parser.add_argument("--xlabel", type=str, default="", help="x-axis label")
296 |     parser.add_argument("--labels", type=str, nargs="+", default=None,
297 |                         help="optional list of names for each series, in order; must match number of --series")
