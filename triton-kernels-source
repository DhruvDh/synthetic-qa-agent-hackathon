12 |     def swizzle_data(self, data):
13 |         # permutation needed to make `data` row major
14 |         to_row_major = sorted(range(data.ndim), key=lambda d: (data.stride(d), d))[::-1]
15 |         # permutation  needed to retrieve original order
16 |         inv = [0] * data.ndim
17 |         for i, d in enumerate(to_row_major):
18 |             inv[d] = i
19 |         # leading dimension must be padded to be aligned to 128
20 |         align_dim = lambda x: (x + 128 - 1) // 128 * 128
21 |         major_dim = data.stride().index(1)
22 |         pad = align_dim(data.shape[major_dim]) - data.shape[major_dim]
23 |         data = torch.nn.functional.pad(data.permute(to_row_major), (0, pad)).permute(inv)
24 |         return data
25 | 
26 |     def unswizzle_data(self, data: torch.Tensor):
27 |         # Trim padding along all dims back to the original shape recorded at init.
28 |         assert data.ndim == len(self.shape), "Rank mismatch between data and recorded shape"
29 |         sizes = [min(data.size(i), self.shape[i]) for i in range(data.ndim)]
30 |         return data[tuple(slice(0, s) for s in sizes)]
