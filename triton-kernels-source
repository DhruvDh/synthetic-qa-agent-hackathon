 22 | def xcd_swizzle(pid, domain_size, XCD_SWIZZLE: tl.constexpr):
 23 |     """
 24 |     Swizzle the program id based on integer XCD_SWIZZLE.
 25 |     This is useful for reording how blocks are ordered. A scheduler may, for example,
 26 |     assign sequential blocks 0, 1, 2, 3, ..., 8, 9, 10.. to its 8 hardware units 0, 1, 2, 3, ..., 0, 1, 2.
 27 |     This pattern may not be ideal for memory access, and it may be better to swizzle so the assignment
 28 |     becomes 0, 0, 0, 0, ..., 1, 1, 1, ... In the swizzled arrangement, sequential blocks are assigned to
 29 |     the same hardware unit.
 30 |     """
 31 |     # Number of pids per group in the new arrangement
 32 |     pids_per_group = domain_size // XCD_SWIZZLE
 33 |     extra_pid_groups = domain_size % XCD_SWIZZLE
 34 | 
 35 |     # Compute current current and local pid within the group
 36 |     group = pid % XCD_SWIZZLE
 37 |     local_pid = pid // XCD_SWIZZLE
 38 | 
 39 |     # Calculate new pid based on the new grouping
 40 |     new_pid = group * pids_per_group + min(group, extra_pid_groups) + local_pid
 41 |     return new_pid
