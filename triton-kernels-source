 30 | def define_kernel(src, module, attrs=None, **extra_globals):
 31 |     """
 32 |     Dynamically create a Triton function or kernel from a src string,
 33 |     linking any symbols in the kernel to objects specified by extra_globals.
 34 |     """
 35 | 
 36 |     # create templace function
 37 |     def _empty_fn():
 38 |         pass
 39 | 
 40 |     gdict = dict(**(_empty_fn.__globals__))
 41 |     gdict.update(extra_globals)
 42 |     f = types.FunctionType(_empty_fn.__code__, gdict)
 43 |     f.__module__ = module.__name__
