14 | class BlackwellMXScaleLayout(Layout):
15 |     name: str = "BLACKWELL_SCALE"
16 | 
17 |     def __init__(self, shape) -> None:
18 |         super().__init__(shape)
19 |         (
20 |             *self.leading_shape,
21 |             self.K,
22 |             self.N,
23 |         ) = shape
24 |         self.B = math.prod(self.leading_shape)
25 |         self.ALIGN_K = 8
26 |         self.ALIGN_N = 128
27 |         self.SWIZZLE_K = 4
28 |         self.K_pad = (self.K + self.ALIGN_K - 1) // self.ALIGN_K * self.ALIGN_K
29 |         self.N_pad = (self.N + self.ALIGN_N - 1) // self.ALIGN_N * self.ALIGN_N
30 | 
31 |     def swizzle_data(self, data):
32 |         data = torch.nn.functional.pad(data, (0, self.N_pad - self.N, 0, self.K_pad - self.K))
33 |         data = data.transpose(-1, -2).contiguous()
34 |         data = data.reshape(self.B, self.N_pad // self.ALIGN_N, self.ALIGN_N // 32, 32, self.K_pad // self.SWIZZLE_K,
35 |                             self.SWIZZLE_K)
36 |         data = data.transpose(2, 4).contiguous()
37 |         data = data.view(1, self.B * self.N_pad // 128, self.K_pad // 4, 2, 256)
38 |         return data
39 | 
