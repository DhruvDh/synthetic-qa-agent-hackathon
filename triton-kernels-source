131 |     # find function parameters
132 |     sig = inspect.signature(triton.runtime.jit.JITFunction.__init__)
133 |     params = list(sig.parameters.values())[2:]
134 |     attrs = {param.name: getattr(fn, param.name, param.default) for param in params}
135 | 
136 |     # make a new repr which appends the repr of the specialized functions.
137 |     base_repr = attrs["repr"]
138 | 
139 |     def new_repr(specialization):
140 |         ret = base_repr(specialization)
141 |         for spec_fn in spec_fns.values():
142 |             spec_repr = spec_fn.repr(None)
143 |             if spec_repr:
144 |                 spec_repr = spec_repr.strip("_")
145 |             if spec_repr:
146 |                 ret += f"_{spec_repr}"
