100 | def topk(
101 |     x: Union[Tensor, torch.Tensor],
102 |     k: int,
103 |     apply_softmax: bool = True,
104 |     dim: int = 1,
105 |     y_indx: Optional[torch.Tensor] = None,
106 |     n_rows: Optional[int] = None,
107 |     all_gather: bool = False,
108 | ):
109 |     """
110 |     Computes the top-k values and indices along a specified dimension of a tensor.
111 |     Note that the input can be either a `Tensor` or a `torch.Tensor`, but the output will always be a `torch.Tensor`.
112 | 
113 |     Parameters
114 |     ----------
115 |     x : Union[triton_kernels.Tensor, torch.Tensor]
116 |         Input tensor of shape (n_tokens, n_expts).
117 |     k : int
118 |         Number of top elements to retrieve.
119 |     apply_softmax : bool, default True
120 |         Whether to apply softmax to the input tensor before computing top-k.
121 |     dim : int, default 1
122 |         Dimension along which to compute top-k.
123 |     y_indx : torch.Tensor, optional
124 |         Pre-allocated tensor for storing indices of top-k elements with shape (n_tokens, k).
125 |         If provided, we skip the computation of top-k indices and use this tensor instead.
126 |     n_rows : int, optional
127 |         Number of rows to apply top-k on. If None, we consider all rows in `x`.
128 | 
129 |     Returns
130 |     -------
131 |     SparseMatrix: sparse matrix equal to `x` with non-selected entries set to 0
132 |     """
133 |     y_vals, y_indx, bitmatrix = TopK.apply(x, k, apply_softmax, dim, y_indx, n_rows, all_gather)
134 |     return SparseMatrix(vals=y_vals, indx=y_indx, mask=bitmatrix)
