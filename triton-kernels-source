 12 | # -----------------------------------------------------------------------
 13 | # Interleave the bits of four consecutive fp4 values (i.e. 16-bits) as:
 14 | #     1000000111000000         (first fp4)
 15 | #        1000000111000000      (second fp4)
 16 | #           1000000111000000   (third fp4)
 17 | #     0110110000000000         (fourth fp4)
 18 | # This is done so that dequantization can be done in 14 SASS instructions
 19 | # -----------------------------------------------------------------------
 20 | 
 21 | 
 22 | def _compress_fp4(x):
 23 |     x = x.to(torch.int32)
 24 |     return ((x & 0x8) << 12) | ((x & 0x7) << 6)
 25 | 
 26 | 
 27 | def _compress_fourth(x):
 28 |     x = x.to(torch.int32)
 29 |     return ((x & 0x8) << 11) | ((x & 0x6) << 9) | ((x & 0x1) << 13)
