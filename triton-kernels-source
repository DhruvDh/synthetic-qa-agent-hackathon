148 | 
149 |     attrs["repr"] = new_repr
150 | 
151 |     if do_not_specialize:
152 |         attrs["do_not_specialize"] = do_not_specialize
153 |     ret = define_kernel(new_src, module, attrs, **globals)
154 | 
155 |     # Reuse the original kernel's metadata so that stack traces and other
156 |     # source-based tooling report the correct file and line numbers.
157 |     ret.raw_src = list(fn.raw_src)
158 |     adjusted_start = max(1, fn.starting_line_number - line_delta)
159 |     ret.starting_line_number = adjusted_start
160 |     orig_code = fn.fn.__code__
161 |     ret.fn.__code__ = ret.fn.__code__.replace(
162 |         co_filename=orig_code.co_filename,
163 |         co_firstlineno=max(1, orig_code.co_firstlineno - line_delta),
