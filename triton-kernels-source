41 |         data = data.reshape(self.B, self.N_pad // self.ALIGN_N, self.K_pad // self.SWIZZLE_K, 32, self.ALIGN_N // 32,
42 |                             self.SWIZZLE_K)
43 |         data = data.transpose(2, 4)
44 |         data = data.reshape(*self.leading_shape, self.N_pad, self.K_pad)
45 |         data = data.transpose(-1, -2)
46 |         return data[..., :self.K, :self.N]
