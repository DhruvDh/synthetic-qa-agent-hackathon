277 | def mxfp4_to_bf16_triton(x, scale, mx_axis: tl.constexpr):
278 |     """
279 |     Implements the bit-untwiddling of a 32-bit integer (8 mxfp4 elements):
280 |     (x << 0) & 0b1000000111000000
281 |     (x << 3) & 0b1000000111000000
282 |     (x << 6) & 0b1000000111000000
283 |     ((x << 1) & 0b1000000000000000) | ((x >> 3) & 0b0000000110000000) | ((x >> 7) & 0b0000000001000000)
284 |     """
285 |     # upcast values to bfloat16
286 |     tl.static_assert(len(x.shape) == 2)
287 |     tl.static_assert(mx_axis == 0 or mx_axis == 1, "mx_axis must be 0 or 1")
288 |     tl.static_assert(x.shape[1] % 4 == 0)
289 |     tl.static_assert(x.dtype == tl.uint8)
290 |     if mx_axis == 0:
291 |         x = x.trans()
292 |     x = _unpack_fp4_to_bf16_triton(x)
293 |     x = _unshuffle_triton(x, mma_version=3)
294 |     if mx_axis == 0:
295 |         x = x.trans()
296 | 
297 |     # upcast scale to bfloat16
298 |     # Add bias missing from the bf16 upcasting sequence
299 |     # triton / LLVM generates terrible code for this sequence
300 |     # scale = scale.to(tl.uint16)
301 |     # scale = scale << 7
302 |     # scale = scale.to(tl.bfloat16, bitcast=True)
303 |     scale = tl.inline_asm_elementwise(
304 |         r"""
305 |         {
306 |             prmt.b32 $0, $2, 0, 0x5140;
307 |             shl.b32 $0, $0, 7;
308 |             prmt.b32 $1, $2, 0, 0x7362;
309 |             shl.b32 $1, $1, 7;
310 |         }
311 |         """,
312 |         constraints="=r,=r,r",
313 |         args=[scale],
314 |         dtype=tl.bfloat16,
315 |         is_pure=True,
316 |         pack=4,
317 |     )
318 |     # Broadcast scale
319 |     scale = scale.expand_dims(mx_axis + 1)
320 |     scale = scale.broadcast_to(scale.shape[:mx_axis + 1] + [32] + scale.shape[mx_axis + 2:])
321 |     scale = scale.reshape(x.shape)
322 | 
323 |     # Combine scale and x
324 |     x = x * scale
325 |     return x
