 59 | def _bf16x2_to_fp4e2m1x2(x):
 60 |     # 0bAxxxxxxBCDxxxxxx_0bExxxxxxFGHxxxxxx  (int32) -> 0bABCD_EFGH (uint8)
 61 |     assert x.dtype == torch.int32
 62 |     lo = (x & 0xFFFF).to(torch.int16)
 63 |     hi = (right_shift_unsigned(x, 16) & 0xFFFF).to(torch.int16)
 64 |     ret_lo = _bf16_to_fp4e2m1(lo)
 65 |     ret_hi = _bf16_to_fp4e2m1(hi)
