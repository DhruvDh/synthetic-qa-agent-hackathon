 32 | def _pack_bits(x: torch.Tensor, mx_axis: int):
 33 |     x = x.contiguous()
 34 |     assert x.shape[-1] % 4 == 0, "Input tensor must have a last dimension divisible by 4"
 35 |     x = x.reshape(x.shape[:-1] + (x.shape[-1] // 4, 4))
 36 |     first = _compress_fp4(x[..., 0]) | (_compress_fp4(x[..., 0] >> 4) << 16)
 37 |     second = _compress_fp4(x[..., 1]) | (_compress_fp4(x[..., 1] >> 4) << 16)
 38 |     third = _compress_fp4(x[..., 2]) | (_compress_fp4(x[..., 2] >> 4) << 16)
 39 |     fourth = _compress_fourth(x[..., 3]) | (_compress_fourth(x[..., 3] >> 4) << 16)
 40 |     x = first | right_shift_unsigned(second, 3) | right_shift_unsigned(third, 6) | fourth
 41 |     assert x.is_contiguous()
 42 |     x = x.view(torch.uint8)
 43 |     return x
