137 | def topk_torch(
138 |     x,
139 |     k,
140 |     apply_softmax: bool = True,
141 |     dim: int = 1,
142 |     y_indx: Optional[torch.Tensor] = None,
143 |     n_rows: Optional[int] = None,
144 | ) -> SparseMatrix:
145 |     if n_rows is None:
146 |         n_rows = x.shape[0]
147 |     has_user_provided_indx = y_indx is not None
148 |     cdiv = lambda a, b: (a + b - 1) // b
149 |     device = x.device
150 |     assert dim == 1
151 |     assert not isinstance(x, Tensor)
152 |     if not has_user_provided_indx:
153 |         y_indx = torch.argsort(-x, dim=1, stable=True)[:, :k]
154 |     y_indx = y_indx.long()
155 |     y_vals = torch.take_along_dim(x[:n_rows, :], y_indx[:n_rows, :], dim=1)
156 |     y_vals = torch.cat([y_vals, x[n_rows:, :k]], dim=0)
157 |     y_indx = y_indx.int()
158 |     # compute bitmatrix
159 |     _, n_cols = x.shape
160 |     bitmatrix_data = torch.zeros((cdiv(n_cols, 32), cdiv(x.shape[0], 32) * 32), dtype=torch.int32, device=device)
161 |     bitmatrix_data = torch.transpose(bitmatrix_data, 0, 1)[:x.shape[0]]
162 |     # fill bitmatrix
163 |     if apply_softmax:
164 |         y_vals = torch.softmax(y_vals.float(), dim=-1).to(x.dtype)
165 |     if not has_user_provided_indx:
166 |         y_indx, sort_indices = torch.sort(y_indx, dim=1)
167 |         y_vals = torch.gather(y_vals, 1, sort_indices)
168 |     y_indx[n_rows:, :] = -1
169 |     rows = torch.arange(x.shape[0], device=device).unsqueeze(1).expand(-1, y_indx.shape[1]).reshape(-1)
170 |     cols = y_indx.reshape(-1)  # 64-bit safe for div/mod
171 |     word_idx = torch.div(cols, 32, rounding_mode='floor')
172 |     bit_idx = cols % 32
173 |     masks = torch.ones_like(bit_idx) << bit_idx
174 |     bitmatrix_data.index_put_((rows, word_idx), masks, accumulate=True)
175 |     bitmatrix_data = bitmatrix_data.view(torch.uint32)
176 |     bitmatrix = Bitmatrix(bitmatrix_data, shape=x.shape, dtype=BIT)
177 |     return SparseMatrix(vals=y_vals, indx=y_indx, mask=bitmatrix)
